# Copy this file to frontend/.env.local if you need to override defaults.

# By default the chat WebSocket connects to ws(s)://<current-host>:8000/ws/chat,
# matching the FastAPI backend's default port. Override this if your backend
# is reachable at a different host/port/scheme (e.g. behind a reverse proxy).
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
