# Copy this file to backend/.env and adjust as needed.

# ── LLM (Groq) ────────────────────────────────────────────────────────────
# Required. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Main answer-generation model. See https://console.groq.com/docs/models
# for the current list of hosted models.
GROQ_MODEL=llama-3.3-70b-versatile
# Model used for the agent's action-selection (planning) step. Defaults to
# GROQ_MODEL; set a smaller/faster model (e.g. llama-3.1-8b-instant) here
# if you want quicker planning turns.
AGENT_MODEL=llama-3.1-8b-instant

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
LLM_TOP_P=0.90

# ── Embeddings (local sentence-transformers, no API key) ─────────────────
# Runs entirely on-device. First run downloads the model from HuggingFace
# (cached locally afterwards); no embedding API or key is used.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ── Vector store (Qdrant, embedded/local) ────────────────────────────────
QDRANT_PATH=./qdrant_db
QDRANT_COLLECTION=enterprise_docs

# ── RAG pipeline ──────────────────────────────────────────────────────────
UPLOAD_FOLDER=./stored_files
PROCESSED_FILES_REGISTRY=./processed_files.json
ENABLE_PDF_OCR_FALLBACK=true
RETRIEVER_K=6
RERANK_TOP_N=4
CONFIDENCE_THRESHOLD=0.02
CHUNK_SIZE=700
CHUNK_OVERLAP=150

# ── Audio / OCR ───────────────────────────────────────────────────────────
WHISPER_MODEL_NAME=small
SILENCE_THRESHOLD_DB=-60.0
# Only needed if ffmpeg/tesseract are not already on your PATH.
FFMPEG_PATH=FFMPEG_path
TESSERACT_CMD=TESSERACT_path
# ── Agent ─────────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=6
AGENT_DEBUG=false
DEFAULT_CONVERSATION_ID=default

# ── Memory ────────────────────────────────────────────────────────────────
MEMORY_MAX_MESSAGES=25
MEMORY_KEEP_RECENT=4
MEMORY_WINDOW=6
MEMORY_STORAGE_DIR=./memory_storage
