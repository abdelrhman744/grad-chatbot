# Copy this file to .env and fill in at least GROQ_API_KEY.
# Every variable below has a working default in config.py if omitted.

# ── CORS ───────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── LLM (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
# Model used for the agent's action-selection (planning) step. Defaults to
# a smaller/faster model since it's a structured routing decision, not open-
# ended generation; set to GROQ_MODEL (or another model) if routing quality
# needs the larger model instead.
AGENT_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
LLM_TOP_P=0.90

# ── Embeddings (local, no API key) ──────────────────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Device for the embedding model AND the cross-encoder reranker below:
# "auto" (default) uses a CUDA GPU if available, otherwise CPU — safe with
# no GPU or a CPU-only torch build installed. Force with "cpu" or "cuda".
# GPU requires a CUDA-enabled torch build, e.g.:
#   pip install --index-url https://download.pytorch.org/whl/cu126 torch==2.13.0
# (match the cuXXX tag to your installed NVIDIA driver — see
# https://pytorch.org/get-started/locally/). Measured ~10x speedup for
# embedding batches and ~6x for cross-encoder scoring on an RTX 3050 — see
# PROFILING.md.
EMBEDDING_DEVICE=auto

# ── Vector store (Qdrant, server mode) ──────────────────────────────────────
# Points at a Qdrant SERVER (REST API), not an embedded/file-mode instance.
# Run `docker compose up --build` (docker-compose.yml at the repo root) to
# start one locally; that same compose file overrides this to
# http://qdrant:6333 for the backend container automatically.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_docs
QDRANT_TIMEOUT_SECONDS=10
# Bounded retry/backoff for Qdrant operations so a container that's still
# starting (or a brief network blip) doesn't immediately fail requests.
QDRANT_CONNECT_RETRIES=5
QDRANT_RETRY_DELAY_SECONDS=2

# ── RAG pipeline / retrieval ─────────────────────────────────────────────────
PROCESSED_FILES_REGISTRY=./processed_files.json
ENABLE_PDF_OCR_FALLBACK=true
# Hard cap (in MB) on a single uploaded file's size — rejected upfront with a
# clear error instead of silently failing partway through ingestion.
MAX_UPLOAD_SIZE_MB=200
RETRIEVER_K=8
RERANK_TOP_N=6
CONFIDENCE_THRESHOLD=0.05
CHUNK_SIZE=700
CHUNK_OVERLAP=150

# Reranking: cross-encoder + lexical blend, diversity selection, context budget
RERANK_USE_CROSS_ENCODER=true
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_ALPHA=0.6
RERANK_DIVERSIFY=true
MMR_LAMBDA=0.7
MAX_CONTEXT_CHARS=6000

# Query expansion: same-language synonym/concept reformulations for
# semantic/evaluative questions ("pros and cons", "which is more efficient").
QUERY_EXPANSION_ENABLED=true

# Chunking strategy: "recursive" (default), "semantic", or "hybrid".
CHUNKING_STRATEGY=recursive
SEMANTIC_CHUNK_BUFFER_SIZE=3
SEMANTIC_CHUNK_BREAKPOINT_PERCENTILE=90.0
SEMANTIC_CHUNK_MAX_CHARS=1800
HYBRID_BASE_CHUNK_SIZE=300
HYBRID_MERGE_SIMILARITY_THRESHOLD=0.62
HYBRID_CHUNK_MAX_CHARS=1800

# Excel/CSV ingestion (.xlsx/.xls/.csv) — row-group chunk size is derived
# from CHUNK_SIZE/CHUNK_OVERLAP above; these only bound how few/many rows a
# single chunk can hold. See loaders/excel_loader.py.
EXCEL_ROWS_PER_CHUNK_MIN=3
EXCEL_ROWS_PER_CHUNK_MAX=50
EXCEL_SUMMARY_SAMPLE_ROWS=5
EXCEL_MAX_ROWS_PER_SHEET=20000

# ── Audio / OCR ──────────────────────────────────────────────────────────────
WHISPER_MODEL_NAME=small
SILENCE_THRESHOLD_DB=-60.0
FFMPEG_PATH=ffmpeg
TESSERACT_CMD=tesseract

# ── Handwritten OCR (TrOCR, local via Hugging Face `transformers`) ──────────
# Free/local — no API key needed. Downloaded automatically on first use and
# cached under the Hugging Face cache dir (see HF_HOME below); reused after
# that. See services/handwritten_ocr_service.py and docs/handwritten-ocr.md.
HANDWRITTEN_OCR_EN_MODEL=microsoft/trocr-small-handwritten
HANDWRITTEN_OCR_AR_MODEL=RayR1/trocr-base-arabic-handwritten
HANDWRITTEN_OCR_MAX_NEW_TOKENS=256
# Multi-line pages are OCR'd in batches of this many lines at once instead
# of one model call per line — see services/handwritten_ocr_service.py.
HANDWRITTEN_OCR_MAX_BATCH_SIZE=8

# Optional — override where `transformers`/`huggingface_hub` cache
# downloaded models. Left unset by default: the library's own default
# (~/.cache/huggingface, i.e. /root/.cache/huggingface in the backend
# container) already falls under the `backend_model_cache` volume
# docker-compose.yml mounts at /root/.cache, so models persist across
# container restarts with no extra configuration. Only set these if you
# want the cache somewhere else entirely.
# HF_HOME=/app/.cache/huggingface
# HF_HUB_CACHE=/app/.cache/huggingface/hub

# ── Agent ────────────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=6
AGENT_DEBUG=false
DEFAULT_CONVERSATION_ID=default

# ── Profiling / debugging ─────────────────────────────────────────────────────
# Per-stage latency breakdown logged for every /api/chat request (see
# utils/timing.py). Negligible overhead — safe to leave on.
LOG_REQUEST_PROFILE=true
# Verbose retrieval debug logging (query variants, per-variant retrieved
# chunks, scores before/after rerank, final context). Off by default — noisy.
LOG_RETRIEVAL_DEBUG=false

# ── Memory ───────────────────────────────────────────────────────────────────
MEMORY_MAX_MESSAGES=25
MEMORY_KEEP_RECENT=4
MEMORY_WINDOW=6
MEMORY_STORAGE_DIR=./memory_storage
# Long-term memory is a capped, deduplicated fact store (not a free-text
# summary paragraph) — see memory/summary_memory.py.
MEMORY_MAX_FACTS=40
MEMORY_SUMMARY_MAX_CHARS=1200
MEMORY_MAX_CHARS=12000

# ── MinIO (object storage for uploaded files & generated reports) ──────────
MINIO_ENDPOINT=localhost:9000
# Host:port used only for presigned download URLs handed to the browser.
# Defaults to MINIO_ENDPOINT — only set this separately when MINIO_ENDPOINT
# is a Docker service name the browser can't resolve (docker-compose.yml
# sets this to localhost:9000 for the backend container automatically).
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_UPLOADS=doc-assistant-uploads
MINIO_BUCKET_REPORTS=doc-assistant-reports
MINIO_PRESIGNED_EXPIRY=3600

# ── Report generation (per-document PDF summary) ────────────────────────────
REPORT_MAP_CHUNK_CHARS=6000
