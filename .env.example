# Copy this file to .env (repo root) to override Compose-level defaults.
# Docker Compose loads this automatically for ${VAR} substitution in
# docker-compose.yml. Per-service application config (GROQ_API_KEY, etc.)
# lives in backend/.env — see backend/.env.example.

# ── MinIO ────────────────────────────────────────────────────────────────
# Change these before exposing MinIO's console/API beyond localhost.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Qdrant ───────────────────────────────────────────────────────────────
QDRANT_IMAGE_TAG=v1.19.0
